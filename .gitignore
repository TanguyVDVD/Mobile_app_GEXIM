# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cible Windows. `ephemeral/` contient le moteur Flutter et les liens
# symboliques vers les greffons, regeneres a chaque build : des centaines de
# mega-octets qui n'ont rien a faire dans le depot. Le reste de `windows/`
# (runner C++, CMakeLists) est du code source et doit etre versionne.
/windows/flutter/ephemeral/

# Signature Android.
#
# La compilation release est signee par la cle designee dans key.properties ;
# sans ce fichier, elle s'arrete (voir le garde-fou en fin de
# android/app/build.gradle.kts) au lieu de retomber sur la cle de debogage.
# Un keystore pousse sur GitHub ne se
# revoque pas : en diffusion directe, il faut desinstaller l'app de chaque
# tablette pour la reinstaller sous une nouvelle identite -- donc perdre la
# base locale et tout releve non synchronise.
*.jks
*.keystore
/android/key.properties

# Configuration de lancement.
#
# La cle « publishable » n'est PAS un secret : elle est embarquee dans chaque
# APK et extractible en une commande. Sa surete vient entierement des policies
# RLS, jamais de sa discretion. On l'ignore quand meme, pour deux raisons :
# l'URL identifie le projet, et un fichier de config finit toujours par
# accueillir un jour une valeur qui, elle, est sensible.
env.json
CLAUDE.md
AS_BUILT_Resserages_RF_model_vierge.xlsm