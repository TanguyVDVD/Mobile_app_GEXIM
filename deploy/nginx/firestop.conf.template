# Configuration du serveur web **à l'intérieur du conteneur**.
#
# C'est un gabarit : au démarrage, l'image nginx y remplace ${SUPABASE_HOST}
# par la valeur du fichier `.env`, et écrit le résultat dans
# /etc/nginx/conf.d/default.conf. Seules les variables d'environnement
# définies sont remplacées — `$uri` et les autres variables de nginx restent
# intactes.
#
# Le conteneur parle en HTTP, sur son port 80 : le HTTPS est fait devant lui,
# par l'Apache du VPS (voir DEPLOY.md).

# Les fichiers d'entrée ne sont **jamais** gardés en cache : ce sont eux qui
# disent au navigateur quelle version charger. Mis en cache, une mise à jour
# déployée resterait invisible des postes déjà venus. Le reste peut l'être une
# journée.
#
# Par une `map` et non un `add_header` dans chaque `location` : dans nginx, un
# `add_header` posé dans un bloc **efface** tous ceux du bloc parent. Les
# en-têtes de sécurité ci-dessous disparaîtraient en silence des fichiers
# concernés — précisément `index.html`.
map $uri $firestop_cache {
    default                       "public, max-age=86400";
    /                             "no-cache";
    /index.html                   "no-cache";
    /flutter_bootstrap.js         "no-cache";
    /flutter_service_worker.js    "no-cache";
    /version.json                 "no-cache";
}

server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Ne pas annoncer la version de nginx.
    server_tokens off;

    gzip on;
    gzip_types application/javascript application/json application/wasm text/css;

    # --- En-têtes : tous ici, aucun dans les `location` (voir la `map`) -------

    add_header Cache-Control             $firestop_cache always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    # L'application n'a aucune raison d'être affichée dans la page d'un autre
    # site : c'est la porte d'entrée du détournement de clic.
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;

    # Ce que la page a le droit de charger, et vers où elle a le droit de
    # parler. Éprouvée sur la version compilée : l'application démarre sans
    # une seule violation.
    #
    #   - `'wasm-unsafe-eval'` autorise l'exécution de WebAssembly (SQLite, le
    #     moteur de rendu), pas celle de JavaScript arbitraire ;
    #   - `blob:` sert au téléchargement du classeur et au fil d'arrière-plan
    #     de la base ;
    #   - `fonts.gstatic.com` : le moteur de rendu y prend sa police (Roboto)
    #     au premier affichage. La retirer d'ici laisse l'application sans
    #     aucun texte lisible ;
    #   - le projet Supabase, en HTTPS et en WebSocket.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://fonts.gstatic.com https://${SUPABASE_HOST} wss://${SUPABASE_HOST}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # SQLite tourne en WebAssembly : servi sous un autre type, le navigateur
    # refuse de l'exécuter, la base locale ne s'ouvre pas et l'application
    # reste sur son écran de démarrage.
    location ~ \.wasm$ {
        types { }
        default_type application/wasm;
    }

    location / {
        # Une adresse inconnue rend l'application, qui fait son propre routage.
        try_files $uri $uri/ /index.html;
    }
}
